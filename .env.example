SPRING_PROFILES_ACTIVE=local
TZ=Asia/Seoul

#APP_IMAGE=운영에만 있음

#POSTGRES_DB=운영에만 있음
#POSTGRES_USER=운영에만 있음
#POSTGRES_PASSWORD=운영에만 있음

DB_URL=jdbc:postgresql://localhost:5433/happyzion
DB_USERNAME=postgres
DB_PASSWORD=postgres

YOUTUBE_API_KEY=replace-me
YOUTUBE_CHANNEL_ID=replace-me

ADMIN_JWT_SECRET=replace-with-at-least-32-byte-secret

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

HAPPYZION_MULTIPART_MAX_FILE_SIZE=200MB
HAPPYZION_MULTIPART_MAX_REQUEST_SIZE=220MB

HAPPYZION_UPLOAD_ROOT=.local/uploads
HAPPYZION_UPLOAD_PUBLIC_BASE_URL=http://localhost:8080/upload
