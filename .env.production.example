SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul

APP_IMAGE=ghcr.io/<github-owner>/<repo>:latest

POSTGRES_DB=happyzion
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password

DB_URL=jdbc:postgresql://db:5432/happyzion
DB_USERNAME=postgres
DB_PASSWORD=replace-with-strong-password

YOUTUBE_API_KEY=replace-me
YOUTUBE_CHANNEL_ID=replace-me

ADMIN_JWT_SECRET=replace-with-at-least-32-byte-secret

SOLAPI_API_KEY=replace-me
SOLAPI_API_SECRET=replace-me
SOLAPI_SENDER=01012345678

CORS_ALLOWED_ORIGINS=https://www.happyzion.com,https://happyzion.com

HAPPYZION_MULTIPART_MAX_FILE_SIZE=200MB
HAPPYZION_MULTIPART_MAX_REQUEST_SIZE=220MB

HAPPYZION_UPLOAD_ROOT=/opt/happyzion/uploads
HAPPYZION_UPLOAD_PUBLIC_BASE_URL=https://api.happyzion.com/upload

HAPPYZION_PII_ENCRYPTION_KEYS=v1:replace-with-base64-of-32-random-bytes
HAPPYZION_PII_ENCRYPTION_ACTIVE_KEY_ID=v1
HAPPYZION_PII_HASH_KEY=replace-with-base64-of-32-random-bytes
